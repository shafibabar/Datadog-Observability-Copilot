    "interpreter": {
      "resolution": {
        "step1_intent": "Match utterance to intents[].id; take resolvesTo.metricType + default aggregation.",
        "step2_service": "Resolve SERVICE synonym -> canonical repo -> metrics.repositories[repo].groupName.",
        "step3_object": "Resolve OBJECT synonym -> opTokens[]; find the metrics.repositories[repo] series whose name contains an opToken AND ends with the metricType nameSuffix.",
        "step4_series": "candidateSeries = groupName + '.' + <matchedMetricName>. If multiple match, prefer exact opToken+suffix; else return list for disambiguation.",
        "step5_query": "Emit {series, aggregation (override with PERCENTILE if latency), groupBy:['tenant'], filters:[tenant?], timeRange}.",
        "step6_validate": "Confirm series is present (or family-inferred=true) in metrics.repositories[repo]. If inferred, tag response confidence='inferred'."
      },
      "aggregationRules": {
        "counter": "sum, optionally .as_rate() when user says 'rate'/'per second'",
        "latency": "percentile (default p99; p50 if 'typical/median'); by {tenant}",
        "error_counter": "sum().as_rate() by {tenant, error_code, exception}",
        "dlt_counter": "sum() by {tenant}",
        "gauge": "latest/avg by {tenant}",
        "infra_kafka_lag": "max by {consumer_group}",
        "infra_pod": "avg/max by {pod, kube_deployment}"
      },
      "defaultTags": [
        "tenant"
      ],
      "queryTemplate": "{aggregation}:{series}{{filters}} by {{groupBy}}",
      "fallbacks": {
        "unknownService": "Ask user to pick from entities.SERVICE.canonicalValues keys.",
        "unknownObject": "List available opTokens for the resolved service.",
        "inferredMetric": "Return best-guess series but set confidence='inferred' and add note 'exact metric name not source-verified for this repo'.",
        "infraVsApp": "If object is a queue/lag/pod concept, route to infra_* series (Datadog agent) not OTel app series."
      }
    }
  },
  "metrics": {
    "commonPatterns": {
      "instruments": [
        {
          "class": "ElapsedTimeMetric",
          "type": "LongHistogram",
          "seriesRule": "GROUP_NAME + '.' + metricName",
          "unit": "ms",
          "userSynonyms": [
            "how slow",
            "latency"
          ]
        },
        {
          "class": "ConsumptionRateCounter",
          "type": "LongCounter",
          "purpose": "per-tenant consumed-message throughput",
          "userSynonyms": [
            "how many processed",
            "throughput"
          ]
        },
        {
          "class": "ErrorRateCounter",
          "type": "LongCounter",
          "tags": [
            "exception",
            "error_code"
          ],
          "userSynonyms": [
            "errors",
            "failures"
          ]
        },
        {
          "annotation": "@RecordLatency(metricName, tenantArgIndex)",
          "handledBy": "RecordLatencyAspect / LatencyRecordingAspect",
          "note": "records ONLY on success (failed calls emit no latency)"
        },
        {
          "annotation": "@ApiMetricName(value)",
          "handledBy": "ApiInterceptor.afterCompletion",
          "emits": "{value}_hit_rate + {value}_error_counter + latency histogram (per tenant)"
        },
        {
          "annotation": "@KafkaConsumerMetricName(value)",
          "note": "AOP sibling of @ApiMetricName for consumers (ec-manual-runs-service)"
        }
      ],
      "infraSeries": [
        {
          "series": "kafka.consumer_lag",
          "note": "per consumer_group; visualized but NOT alert-monitored",
          "userSynonyms": [
            "lagging",
            "backed up",
            "behind"
          ]
        },
        {
          "series": "kubernetes_state.container.restarts | kubernetes.memory.usage | kubernetes.cpu.usage.total",
          "userSynonyms": [
            "restarts",
            "OOM",
            "cpu",
            "pod health"
          ]
        },
        {
          "series": "mongodb.opcounters.* | mongodb.replset.replicationlag",
          "userSynonyms": [
            "db load",
            "replication lag"
          ]
        },
        {
          "series": "jmx.debezium.mongodb.milli_seconds_behind_source | number_of_disconnects",
          "userSynonyms": [
            "CDC lag",
            "debezium behind"
          ]
        }
      ]
    },
    "repositories": {
      "ec-indexer": {
        "confidence": "high",
        "groupName": "ec.indexer",
        "tags": [
          "tenant",
          "topic",
          "reconciliation_token",
          "window_token",
          "source",
          "sourceId",
          "exception",
          "error_code"
        ],
        "unitEnum": [
          "messages",
          "ms"
        ],
        "series": [
          {
            "name": "*_latency",
            "type": "latency",
            "via": "ElapsedTimeMetric / @RecordLatency",
            "objects": [
              "s3 download",
              "bulk index",
              "audio enrichment",
              "parent reindex"
            ]
          },
          {
            "name": "*_counter",
            "type": "counter",
            "via": "ConsumptionRateCounter",
            "objects": [
              "IngestedCommunicationConsumer",
