{
  "$schema": "ec-surveillance-datadog-metrics-nlp/v1",
  "metadata": {
    "name": "EC Surveillance Datadog Metrics — NLP Grammar + Interpreter + Catalog",
    "description": "Three-layer artifact. (1) nlpInterface: a natural-language grammar (intents, entities, synonyms) a non-technical user speaks/types, plus a deterministic 'interpreter' spec that turns a parsed utterance into a concrete Datadog/OTel query. (2) metrics: the per-repo catalog of emitted series the interpreter resolves against. (3) examples: worked NL->query resolutions. Metrics are OTel (com.smarsh.observability.telemetry.Metrics -> LongCounter/LongHistogram) exported to Datadog; full series name = GROUP_NAME + '.' + metricName.",
    "howToUse": "1) NLU matches utterance -> intent (nlpInterface.intents). 2) Extract slots and normalize each via nlpInterface.entities[*].synonyms -> canonical value. 3) interpreter.resolution builds {series, aggregation, groupBy, filters, timeRange}. 4) Validate series against metrics.repositories[service]. 5) If service/metric unresolved, use interpreter.fallbacks.",
    "emissionMechanism": {
      "sdk": "com.smarsh.observability.telemetry.Metrics",
      "types": [
        "LongCounter",
        "LongHistogram",
        "gauge (ReconJobGauge/PendingPipelinesGauge)"
      ],
      "exporter": "OTLP -> Datadog (K8s: DD_TRACE_ENABLED=false, TELEMETRY_PROVIDER=OTEL)",
      "fullSeriesNameRule": "GROUP_NAME + '.' + metricName",
      "groupNameIsInconsistent": {
        "ec.indexer": "dot-style",
        "ec.surveillance_filter": "underscore",
        "ec.surveillance_policy_evaluator": "underscore",
        "ec.review_service": "underscore"
      }
    }
  },
  "nlpInterface": {
    "description": "Everything the interpreter needs to understand a non-technical user. intents = what they want; entities = the vocabulary + synonyms it maps to canonical tokens; interpreter = deterministic assembly rules.",
    "intents": [
      {
        "id": "GET_THROUGHPUT",
        "meaning": "How many of something were processed / the volume or rate.",
        "utterances": [
          "how many {object} did we {verb}",
          "how many {object}",
          "what's the {object} volume",
          "throughput of {object}",
          "count of {object}",
          "how many messages went through {service}",
          "how busy is {service}"
        ],
        "slots": {
          "object": "OBJECT",
          "service": "SERVICE",
          "timeRange": "TIME_RANGE",
          "tenant": "TENANT"
        },
        "resolvesTo": {
          "metricType": "counter",
          "aggregation": "sum_as_rate"
        }
      },
      {
        "id": "GET_LATENCY",
        "meaning": "How slow / how long something takes.",
        "utterances": [
          "how slow is {object}",
          "how long does {object} take",
          "{object} response time",
          "{object} latency",
          "is {service} slow",
          "p99 of {object}",
          "tail latency for {object}"
        ],
        "slots": {
          "object": "OBJECT",
          "service": "SERVICE",
          "percentile": "PERCENTILE",
          "timeRange": "TIME_RANGE",
          "tenant": "TENANT"
        },
        "resolvesTo": {
          "metricType": "latency",
          "aggregation": "p99"
        }
      },
      {
        "id": "GET_ERRORS",
        "meaning": "How many failures / error rate / what broke.",
        "utterances": [
          "how many errors in {service}",
          "what's failing in {service}",
          "error rate for {object}",
          "how many {object} failed",
          "is {service} broken",
          "failures for {object}"
        ],
        "slots": {
          "object": "OBJECT",
          "service": "SERVICE",
          "timeRange": "TIME_RANGE",
          "tenant": "TENANT"
        },
        "resolvesTo": {
          "metricType": "error_counter",
          "aggregation": "sum_as_rate"
        }
      },
      {
        "id": "GET_DEADLETTER",
        "meaning": "How many messages were given up on / dead-lettered.",
        "utterances": [
          "how many {object} were dead-lettered",
          "how many messages did {service} give up on",
          "poison messages in {service}",
          "dropped {object}",
          "dlt count for {service}"
        ],
        "slots": {
          "object": "OBJECT",
          "service": "SERVICE",
          "timeRange": "TIME_RANGE",
          "tenant": "TENANT"
        },
        "resolvesTo": {
          "metricType": "dlt_counter",
          "aggregation": "sum"
        }
      },
      {
        "id": "GET_LAG",
        "meaning": "Is a service backed up / behind on its queue.",
        "utterances": [
          "is {service} lagging",
          "is {service} backed up",
          "is {service} behind",
          "queue depth for {service}",
          "consumer lag {service}",
          "is {service} keeping up"
        ],
        "slots": {
          "service": "SERVICE",
          "tenant": "TENANT"
        },
        "resolvesTo": {
          "metricType": "infra_kafka_lag",
          "aggregation": "max",
          "series": "kafka.consumer_lag"
        }
      },
      {
        "id": "GET_HEALTH",
        "meaning": "Overall health / is it up / pod restarts / memory.",
        "utterances": [
          "is {service} healthy",
          "is {service} up",
          "pod restarts for {service}",
          "memory usage of {service}",
          "cpu of {service}",
          "is {service} crashing"
        ],
        "slots": {
          "service": "SERVICE"
        },
        "resolvesTo": {
          "metricType": "infra_pod",
          "series": [
            "kubernetes_state.container.restarts",
            "kubernetes.memory.usage",
            "kubernetes.cpu.usage.total"
          ]
        }
      },
      {
        "id": "GET_COMPLETION",
        "meaning": "Did a run/window finish; reconciliation status; corpus counts.",
        "utterances": [
          "did the run finish",
          "is reconciliation done",
          "how many messages were reconciled",
          "monitored corpus for {tenant}",
          "how many were alerted / sampled / ignored",
          "completion status"
        ],
        "slots": {
          "stage": "STAGE",
          "tenant": "TENANT",
          "timeRange": "TIME_RANGE"
        },
        "resolvesTo": {
          "metricType": "counter|gauge",
          "service": "ec-centralised-audit|ec-reporting|ec-surveillance-quota-manager"
        }
      }
    ],
