{
  "$schema": "ec-surveillance-nlp-grammar/v1",
  "metadata": {
    "name": "EC Surveillance NLP Grammar & Synonym Map",
    "description": "Maps non-technical user phrasing to code symbols AND runtime Kafka event/topic names across the 12 Enterprise Conduct (EC) surveillance repositories. Use `globalConcepts` for cross-repo synonym resolution, `stageLifecycle` for the communication journey, and `repositories` for per-repo disambiguation.",
    "conventions": {
      "{tenant}": "runtime-substituted tenant name",
      "{windowToken}|{wt}": "runtime freeze/quota window version suffix",
      "{sourceId}": "runtime manual-run / source id suffix",
      "note": "The same word (e.g. 'queue', 'filter') can mean different things in different repos; always cross-check the repositories section."
    },
    "repos": [
      "ec-gateway",
      "ec-queue-qualifier",
      "ec-surveillance-filter",
      "ec-surveillance-policy-evaluator",
      "ec-surveillance-quota-manager",
      "ec-alerting-service",
      "ec-indexer",
      "ec-review-service",
      "ec-reporting",
      "ec-manual-runs-service",
      "ec-centralised-audit",
      "ec-echo-engine"
    ]
  },
  "globalConcepts": [
    {
      "canonical": "pipeline",
      "userSynonyms": [
        "queue",
        "supervision queue",
        "review queue",
        "channel",
        "policy queue"
      ],
      "codeSymbols": [
        "pipeline",
        "pipelineId",
        "PipelineConfig",
        "PipelineConfigEntity",
        "SupervisionQueueEntity",
        "pipeline-catalog",
        "surveillance-pipelines",
        "PipelineSurveilledPopulation",
        "queueMetadata",
        "QueueMetadata.Queue"
      ],
      "runtimeNames": [
        "ec.config-curator.{tenant}.surveillance-pipelines",
        "pipeline-surveilled-population_{windowToken}",
        "pipeline-catalog_{windowToken}",
        "ec-reporting-pipelines_{windowToken}"
      ],
      "repos": [
        "ec-queue-qualifier",
        "ec-surveillance-filter",
        "ec-review-service",
        "ec-reporting",
        "ec-centralised-audit"
      ],
      "note": "UI/user term is 'queue'; backend term is 'pipeline'. ec-review-service literally models a pipeline as SupervisionQueueEntity; ec-reporting maps queueMetadata.queue.id == pipelineId."
    },
    {
      "canonical": "quota_sampling",
      "userSynonyms": [
        "sample",
        "random sample",
        "quota",
        "percentage",
        "spot check",
        "random review",
        "bucket"
      ],
      "codeSymbols": [
        "SamplingMode",
        "SamplingProfile",
        "samplingProfile",
        "QuotaWindowEntity",
        "PipelineBucket",
        "PipelineBucketEntity",
        "ProbabilisticSamplingService",
        "SamplingService.shouldSample",
        "QuotaManagerStoreServiceV2",
        "QUOTA_POLICY_RANDOM_SPLIT",
        "QuotaPolicyRandomSplitModeBucketingStrategy",
        "SamplingBucketRedisStorageRepository",
        "HITS",
        "RANDOM"
      ],
      "runtimeNames": [
        "ec.config-curator.{tenant}.surveillance-sampling",
        "ec.surveillance-quota-manager.{tenant}.quota-windows",
        "SURVEILLED_COMMS_SAMPLED",
        "SURVEILLED_COMMS_NOT_SAMPLED",
        "ec.surveillance-quota-manager.not-sampled",
        "ec.surveillance-quota-manager.random.not-sampled",
        "ec.surveillance-quota-manager.random.ignored",
        "ec.surveillance-quota-manager.ignored"
      ],
      "repos": [
        "ec-surveillance-quota-manager",
        "ec-reporting",
        "ec-gateway"
      ],
      "note": "'quota' = target sampling percentage; 'sampling' = act of random selection. Two bucket prefixes: 'hits' (policy-matched) vs 'random'."
    },
    {
      "canonical": "qualify",
      "userSynonyms": [
        "selected",
        "picked up",
        "belongs to",
        "matched population",
        "in scope",
        "monitored"
      ],
      "codeSymbols": [
        "PipelineQualifierService.qualifyIngestedCommunication",
