  "stageLifecycle": {
    "description": "Ordered journey of a single communication through the pipeline. Each stage lists the owning repo, the runtime terminal/emit event names, and the code entity name at that stage.",
    "stages": [
      {
        "order": 1,
        "stage": "ingested",
        "userSynonyms": [
          "received",
          "came in",
          "arrived"
        ],
        "repo": "ec-gateway",
        "codeEntity": "BulkIndexEvent / IngestedCommunicationOutbox",
        "runtimeEvents": [
          "supBulkIndexingTopic_k8s",
          "ec.surveillance-gateway.outbox.{tenant}.ingestedCommunication",
          "eg.ingested"
        ]
      },
      {
        "order": 2,
        "stage": "qualified",
        "userSynonyms": [
          "selected",
          "picked up",
          "in scope"
        ],
        "repo": "ec-queue-qualifier",
        "codeEntity": "QualifiedCommunicationDto",
        "runtimeEvents": [
          "ec.surveillance-qualifier.{tenant}.qualifications",
          "qq.qualified"
        ],
        "altBranch": "not-qualified -> ec.centralized.{tenant}.audit"
      },
      {
        "order": 3,
        "stage": "filtered_evaluated",
        "userSynonyms": [
          "processed",
          "ignored",
          "passed rule"
        ],
        "repo": "ec-surveillance-filter",
        "codeEntity": "PipelineEvaluationEvent / PolicyEvaluationOutput",
        "runtimeEvents": [
          "ec.surveillance-filter.{tenant}.evaluations",
          "sf.qualified",
          "sf.not.ignored"
        ],
        "terminalOutcomes": [
          "FILTERED",
          "NOT_FILTERED",
          "ec.surveillance-filter.pipelines.filtered"
        ]
      },
      {
        "order": 4,
        "stage": "policy_evaluated",
        "userSynonyms": [
          "scanned",
          "AI checked",
          "matched content"
        ],
        "repo": "ec-surveillance-policy-evaluator",
        "codeEntity": "CognitionResponseEvent",
        "runtimeEvents": [
          "ec.surveillance-policy-evaluator.{tenant}.surveilled",
          "pe.initiated",
          "pe.evaluated"
        ],
        "branch": [
          "metadata pass-through -> surveilled topic",
          "content -> Cognition Kafka topic (CIMS/COMS)"
        ],
        "terminalOutcomes": [
          "ec.surveillance-policy-evaluator.filtered",
          "ec.surveillance-policy-evaluator.failed",
          "ec.surveillance-policy-evaluator.coms-failed"
        ]
      },
      {
        "order": 5,
        "stage": "surveilled_sampled",
        "userSynonyms": [
          "sampled",
          "quota applied",
          "random selected"
        ],
        "repo": "ec-surveillance-quota-manager",
        "codeEntity": "SurveilledEntity / QuotaManagerStoreEntity",
        "runtimeEvents": [
          "ec.surveillance-quota-manager.{tenant}.surveilled-communication-outbox",
          "qm.stored"
        ],
        "terminalOutcomes": [
          "SURVEILLED_COMMS_SAMPLED",
          "SURVEILLED_COMMS_NOT_SAMPLED",
          "ec.surveillance-quota-manager.not-sampled",
          "ec.surveillance-quota-manager.random.not-sampled"
        ]
      },
      {
        "order": 6,
        "stage": "alerted",
        "userSynonyms": [
          "flagged",
          "alert created",
          "case opened"
        ],
        "repo": "ec-alerting-service",
        "codeEntity": "SupervisedItem / AlertedCommunicationEvent",
        "runtimeEvents": [
          "ec.alerting-service.{tenant}.alert-outbox",
          "ec.alerting-service.{tenant}.alertedCommunication"
        ]
      },
      {
        "order": 7,
        "stage": "echo_detected",
        "userSynonyms": [
          "duplicate detected",
          "deduped",
          "cancelled"
        ],
        "repo": "ec-echo-engine",
        "codeEntity": "EchoActionEvent / EchoCorrelationResult",
        "runtimeEvents": [
          "ec.echo-engine.{tenant}.echoAction",
          "ec.alerting-service.{tenant}.echoCommunication"
        ],
        "classifications": [
          "ORIGINAL/NOT_APPLICABLE",
          "ECHO/CLOSE",
          "ECHO/UPDATE",
          "OUT_OF_ORDER"
        ]
      },
      {
        "order": 8,
        "stage": "indexed",
        "userSynonyms": [
          "searchable",
          "archived",
          "stored"
        ],
        "repo": "ec-indexer",
        "codeEntity": "BulkDocumentEntry",
        "runtimeEvents": [
          "ec.centralized.{tenant}.audit.indexer.event",
          "surveil.av5",
          "review.v1"
        ]
      },
      {
        "order": 9,
        "stage": "reviewed",
        "userSynonyms": [
          "actioned",
          "closed",
          "escalated",
          "assigned"
        ],
        "repo": "ec-review-service",
        "codeEntity": "SupervisionQueueEntity / ReviewEntitlements",
        "runtimeEvents": [
          "supervised_items"
        ]
      },
      {
        "order": 10,
        "stage": "audited_reconciled",
        "userSynonyms": [
          "tracked",
          "completed",
          "reconciled"
        ],
        "repo": "ec-centralised-audit",
        "codeEntity": "AuditEvent / QuotaWindowReconciliationEntity",
        "runtimeEvents": [
          "ec.centralized.{tenant}.audit",
          "ec.centralised-audit.outbox.{tenant}.windowReconciliation"
        ]
      },
      {
        "order": 11,
        "stage": "reported",
        "userSynonyms": [
          "counted",
          "report generated",
          "KPI"
        ],
        "repo": "ec-reporting",
        "codeEntity": "PipelineExecutionReport / EventLogMessage",
        "runtimeEvents": [
          "conduct_audit_topic",
          "eventloggingpublisher_k8s"
        ]
      }
    ]
  },
  "repositories": {
