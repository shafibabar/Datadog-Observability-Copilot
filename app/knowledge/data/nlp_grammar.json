        "{originalTopic}-conduct-ingestion-dlt",
        "ec.surveillance-gateway.{tenant}.remediation",
        "ec.on-demand.remediation-dlt",
        "{manualRunTopic}-retry-{0,1}",
        "{manualRunTopic}-dlt"
      ],
      "restApis": [
        "GET /v1/{tenant}/watermark/{source}/{sourceId}/{reconciliationToken}",
        "POST /v1/tenants/{tenantName}/bootstrap-config",
        "POST /v1/tenants/{tenantName}/manual-run-bootstrap-config",
        "POST /v1/{tenantName}/ingestion/tracker"
      ],
      "stores": [
        "MongoDB: IngestedCommunicationOutbox",
        "QualifiedCommunicationOutbox",
        "ReconciliationWindowEntity",
        "AWS S3 (indexable/miniIndexable)"
      ],
      "keyTerms": {
        "watermark": "count of ingested comms",
        "POLICY_INDEX_REINDEX": "reindex source that is forwarded to remediation",
        "minify": "miniIndexable.json reduction"
