      ],
      "note": "'Qualified' = the communication's participants match a pipeline's monitored population. 0 matches => routed to audit as not-qualified."
    },
    {
      "canonical": "filter_evaluate",
      "userSynonyms": [
        "filtered",
        "processed",
        "ignored",
        "flagged",
        "matched",
        "caught",
