{
  "$schema": "ec-surveillance-nlp-examples/v1",
  "metadata": {
    "name": "EC Surveillance NLP Examples Corpus",
    "description": "Training/eval corpus of natural-language utterances a non-technical user might type, each mapped to the parsed intent + normalized slots + the deterministic resolved Datadog/OTel query. Companion to ec-surveillance-datadog-metrics-nlp.json (intents/entities/interpreter live there). Full series name = GROUP_NAME + '.' + metricName.",
    "intentLegend": {
      "GET_THROUGHPUT": "counter / consumption rate (how many, volume)",
      "GET_LATENCY": "histogram (how slow, response time, p99/p95)",
      "GET_ERRORS": "error_counter / error_rate (failures)",
      "GET_DEADLETTER": "dlt_counter (given up / poison messages)",
      "GET_LAG": "kafka.consumer_lag (backed up / behind)",
      "GET_PODHEALTH": "k8s infra (restarts / OOM / cpu)",
      "GET_COMPARISON": "two-series comparison",
      "GET_BUSINESS_KPI": "domain outcome counts (sampled, filtered, alerted, reconciled)"
    },
    "slotLegend": {
      "intent": "matched intent id",
      "service": "canonical repo name",
      "object": "canonical domain object (see grammar globalConcepts)",
      "metricType": "counter|latency|error_counter|dlt_counter|lag|gauge",
      "aggregation": "sum_as_rate|p99|p95|p50|avg|max",
      "tenant": "resolved tenant filter or * ",
      "timeRange": "resolved lookback window",
      "resolvedQuery": "concrete series the interpreter emits",
      "confidence": "verified|medium|inferred"
    }
  },
  "examples": [
    {
      "id": "TH-001",
      "utterance": "how many messages did the indexer process today?",
      "parsed": {
        "intent": "GET_THROUGHPUT",
