{
  "$schema": "ec-surveillance-error-catalog/v1",
  "metadata": {
    "name": "EC Surveillance Error Catalog & Synonym Map",
    "description": "All error constructs emitted across the 12 Enterprise Conduct (EC) surveillance repos: custom exception classes, per-service API ErrorCode enums, runtime log-error phrases, and Kafka failure/DLT event names. Includes user-facing synonyms so a model can map non-technical phrasing (e.g. 'it broke', 'stuck', 'rejected') to concrete errors.",
    "confidenceNotes": {
      "apiErrorCodes": "Verified from ErrorCode.java enums except ec-gateway and ec-manual-runs-service (no enum; GlobalExceptionHandler + ErrorResponse).",
      "customExceptions": "Class names verified via file listing. Exact throw-site message strings only known where explicitly captured; others null.",
      "runtimeLogErrors": "Representative sample from eventRecorder.error/fatal call sites, not exhaustive."
    }
  },
  "commonAcrossAllRepos": {
    "sharedExceptions": [
      {
        "class": "NonRetryableEventException",
        "meaning": "Event should NOT be retried; route straight to DLT.",
        "userSynonyms": [
          "permanent failure",
          "unrecoverable",
          "gave up",
          "dead-lettered",
          "poison message",
          "bad message"
        ]
      },
      {
        "class": "CloneCollectionException",
        "meaning": "bootstrap-config collection clone failed (source collection missing).",
        "userSynonyms": [
          "setup failed",
          "bootstrap failed",
          "config copy failed",
          "missing collection"
        ],
        "presentIn": [
          "ec-queue-qualifier",
          "ec-surveillance-filter",
          "ec-surveillance-policy-evaluator",
          "ec-surveillance-quota-manager",
          "ec-alerting-service",
          "ec-reporting",
          "ec-centralised-audit",
          "ec-echo-engine"
        ]
      }
    ],
    "sharedApiErrorCodes": [
      {
        "key": "BAD_REQUEST",
        "description": "Bad request - invalid or missing parameters",
        "http": 400,
        "userSynonyms": [
          "bad request",
          "invalid input",
          "wrong parameters",
          "malformed request",
          "missing fields"
        ]
      },
      {
        "key": "INVALID_TENANT",
        "description": "Invalid tenant name. Tenant is not in the list of enabled tenants",
        "http": 400,
        "userSynonyms": [
          "unknown customer",
          "tenant not enabled",
          "org not found",
          "not onboarded",
          "disabled tenant"
        ]
      },
      {
        "key": "INTERNAL_SERVER_ERROR",
        "description": "Internal server error",
        "http": 500,
        "userSynonyms": [
          "it broke",
          "crashed",
          "server error",
          "something went wrong",
          "500 error",
          "unexpected error"
        ]
      },
      {
        "key": "SOURCE_COLLECTION_DOESNT_EXIST",
        "description": "Source collection does not exist",
        "http": 500,
        "userSynonyms": [
          "missing data",
          "collection not found",
          "no source",
          "setup missing"
        ]
      },
      {
        "key": "VALIDATION_ERROR",
        "description": "Validation error",
        "http": 400,
        "userSynonyms": [
          "invalid",
          "rejected",
          "failed validation",
          "not allowed",
          "constraint violation"
        ]
      }
    ],
    "servicePrefixes": {
      "ec-surveillance-filter": "SF",
      "ec-reporting": "ER",
      "ec-alerting-service": "AS",
      "ec-queue-qualifier": "QQ",
      "ec-centralised-audit": "CA",
      "ec-surveillance-quota-manager": "QM",
      "ec-surveillance-policy-evaluator": "PE",
