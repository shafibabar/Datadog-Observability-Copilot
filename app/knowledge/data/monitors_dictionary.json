{
  "$schema": "ec-surveillance-datadog-dashboards-monitors-dictionary/v1",
  "metadata": {
    "name": "EC Surveillance Datadog Dashboard & Monitor Dictionary (NLP synonym map)",
    "description": "Maps non-technical phrasing ('is anything on fire?', 'the gateway board', 'are we behind?') to the concrete Datadog monitor module names, dashboard module names, widget groups, Slack channels, and severities defined in the ec-conduct-dd-monitors Terraform repo. Companion to the metrics/errors/grammar JSONs. Source-of-truth repo: Smarsh/ec-conduct-dd-monitors (workpack in Smarsh/1sp-conduct-ai).",
    "sourceRepo": "Smarsh/ec-conduct-dd-monitors",
    "verifiedAgainst": "workpack pin 6821e6f9 (monitor catalog byte-unchanged from 5814aaf2)",
    "conventions": {
      "{env}|{kube_namespace}": "e.g. ep-ms-prod, ep-sc-prod, ep-perflab-uat, ep-smarsh-staging, ep-mt7-uat",
      "{tenant}": "logical tenant, e.g. msprod, conductprod",
      "monitorType": "every monitor is Datadog `query alert`; no SLO/composite/log monitors exist",
      "notification": "Slack-only: @slack-Smarsh_Via_App-<alert_channel>; P1/P2/P3 via Datadog priority",
      "criticalZero": "critical = 0 means 'alert if the error/DLT counter is > 0' (any occurrence)"
    }
  },
  "globalTerms": [
    {
      "canonical": "monitor",
      "userSynonyms": [
        "alert",
        "alarm",
        "alerting rule",
        "page",
        "trigger",
        "watchdog",
        "detector",
        "the thing that pages us"
      ],
      "codeSymbols": [
        "datadog_monitor",
        "modules/<monitor_name>",
        "query alert",
        "monitor_thresholds"
      ],
      "note": "A monitor lives in modules/<name>/main.tf and fans out per-tenant/per-service via for_each."
    },
    {
      "canonical": "dashboard",
      "userSynonyms": [
        "board",
        "screen",
        "view",
        "graphs",
        "charts",
        "panel",
        "the ops screen",
        "status page"
      ],
      "codeSymbols": [
        "datadog_dashboard",
        "modules/<name>_dashboard",
        "*_specs.tf",
        "widget group",
        "template_variable",
        "preset",
        "saved view"
      ],
      "note": "Dashboards declare NO alert thresholds - only monitors do. Widget-groups are the *_specs.tf files."
    },
    {
      "canonical": "severity",
      "userSynonyms": [
        "priority",
        "how bad",
        "urgency",
        "page vs warning",
        "tier"
      ],
      "codeSymbols": [
        "priority = 1",
        "priority = 2",
        "priority = 3",
        "P1",
        "P2",
        "P3",
        "<!channel>"
      ],
      "mapping": {
        "P1": "critical - pages, <!channel>",
        "P2": "warning",
        "P3": "low / lookback"
      }
    },
    {
      "canonical": "alert_channel",
      "userSynonyms": [
        "slack channel",
        "who gets pinged",
        "where it alerts",
        "notification target"
      ],
      "codeSymbols": [
        "@slack-Smarsh_Via_App-${lower(env.alert_channel)}",
        "ec-alerts-<client>-p1",
        "ec-alerts-<client>-p2"
      ],
      "examples": [
        "ec-alerts-ms-p1",
        "ec-alerts-ms-p2",
        "ec-alerts-sc-p1",
        "ec-alerts-sc-p2",
        "ec-alerts-staging-p1",
        "ec-alerts-staging-p2"
      ]
    },
    {
      "canonical": "consumer_lag",
      "userSynonyms": [
        "backed up",
        "behind",
        "falling behind",
        "lag",
        "queue building up",
        "not keeping up",
        "stuck"
      ],
      "codeSymbols": [
        "kafka.consumer_lag",
        "consumer_group:"
      ],
      "gap": true,
      "note": "57 dashboard widgets but ZERO monitors - user asking 'are we backed up?' can only be answered from a dashboard, never from an alert."
    },
    {
      "canonical": "pod_health",
      "userSynonyms": [
        "crashing",
        "restarting",
        "out of memory",
        "OOM",
        "crashloop",
        "pod down",
        "5xx",
        "service unhealthy"
      ],
      "codeSymbols": [
        "kubernetes_state.pod.status_phase",
        "kubernetes_state.container.restarts",
        "kubernetes.memory.usage",
        "kubernetes.cpu.usage.total",
        "container.cpu.throttled"
      ],
      "gap": true,
      "note": "Dashboard-only; no crashloop/OOM/5xx alert monitor exists."
    }
  ],
  "monitors": [
    {
      "module": "debezium_connector_failure",
      "userSynonyms": [
        "CDC broke",
        "connector failed",
        "debezium down",
        "replication task failed",
        "change stream stopped"
      ],
      "watches": "ec-surveillance-debezium / Kafka Connect connector failed tasks",
      "metric": "jmx.kafka.connect.connector_failed_task_count",
      "query": "avg(last_5m):sum:jmx.kafka.connect.connector_failed_task_count{kube_namespace:<env>} by {connector} > 0",
      "threshold": "critical = 0 (any failed task)",
      "priority": "P1",
      "coverage": "5 instances (non-prod 3 + prod 2)"
    },
    {
      "module": "debezium_connector_behind_source",
      "userSynonyms": [
        "CDC lagging",
        "debezium behind",
        "replication lag",
        "change stream slow",
        "falling behind mongo"
      ],
      "watches": "ec-surveillance-debezium replication lag vs MongoDB oplog",
      "metric": "jmx.debezium.mongodb.milli_seconds_behind_source",
      "query": "avg(last_5m):max:jmx.debezium.mongodb.milli_seconds_behind_source{kube_namespace:<env>} by {connector} / 1000 > 1800",
      "threshold": "warning = 600s (10m), critical = 1800s (30m)",
      "priority": "P1",
      "coverage": "5 instances"
    },
    {
      "module": "bootstrap_config_cron_failure",
      "userSynonyms": [
        "bootstrap job failed",
        "config setup broke",
        "nightly config job failed",
        "tenant config bootstrap error"
      ],
      "watches": "ec-config-curator BOOTSTRAP_CONFIG cron",
      "metric": "ec.config_curator.BOOTSTRAP_CONFIG_job_failed_rate",
      "query": "sum(last_60m):sum:ec.config_curator.BOOTSTRAP_CONFIG_job_failed_rate{kube_namespace:<env>} by {exception,tenant}.as_count() > 0",
      "threshold": "critical = 0",
      "priority": "P1",
      "note": "This is a CRON failure, not a service-startup failure."
    },
    {
      "module": "freeze_config_cron_failure",
      "userSynonyms": [
        "freeze job failed",
        "config snapshot broke",
        "freeze window cron error",
        "config lock job failed"
      ],
      "watches": "ec-config-curator FREEZE_CONFIG cron",
      "metric": "ec.config_curator.FREEZE_CONFIG_job_failed_rate",
      "query": "sum(last_5m):sum:ec.config_curator.FREEZE_CONFIG_job_failed_rate{kube_namespace:<env>} by {exception,tenant}.as_count() > 0",
      "threshold": "critical = 0",
      "priority": "P1"
    },
    {
      "module": "data_plane_freeze_window_failure",
      "userSynonyms": [
        "freeze window consumer error",
        "config freeze failed in pipeline",
        "freeze event error"
      ],
      "watches": "freeze-window Kafka consumer in policy-evaluator, quota-manager, queue-qualifier (3 services)",
      "metric": "<service.prefix>.freeze_window_consumer_error_counter",
      "services": [
        "ec.surveillance_policy_evaluator",
        "ec.quota_manager",
        "ec.pipeline_qualifier"
      ],
      "threshold": "critical = 0",
      "priority": "P1",
      "coverage": "15 instances (3 services x tenants)"
    },
    {
      "module": "quota_manager_metadata_comms_consumer_error",
      "userSynonyms": [
        "quota manager metadata failed",
        "sampling metadata consumer error",
        "metadata comms dead-lettered"
      ],
      "watches": "ec-surveillance-quota-manager metadata-comms consumer DLT",
      "metric": "ec.quota_manager.metadata_comms_consumer_dlt_counter",
      "threshold": "critical = 0",
      "priority": "P1"
    },
    {
      "module": "qualified_comms_failure_rate",
      "userSynonyms": [
        "pipeline error rate",
        "end to end failures",
        "is the pipeline healthy",
        "overall error rate",
        "messages failing"
      ],
      "watches": "END-TO-END rate across queue-qualifier + surveillance-filter + policy-evaluator + quota-manager (8 error counters / qualifier rate)",
      "metric": "composite: 8 error counters ÷ ec.surveillance_filter.queue_qualifier_event_consumption_rate ×100",
      "threshold": "critical = 0.01 (%)",
      "priority": "P1",
      "note": "The ONLY end-to-end alert. WARNING: QM terms use prefix ec.surveillance.quota_manager.* which may be no-data (green != healthy)."
    },
    {
      "module": "manual_run_token_null_failure",
      "userSynonyms": [
        "manual run failed",
        "re-run token missing",
        "lookback date didn't resolve",
        "manual run window token null"
      ],
      "watches": "ec-manual-runs-service - manual-run date not resolving to a window token",
      "metric": "ec.manual_run_service.manual_run_window_token_missing_error_counter",
      "threshold": "critical = 0",
      "priority": "P2",
      "gap": true,
      "note": "NEW monitor wired AHEAD of its metric - metric not yet emitted, so reads green (no-data trap)."
    },
    {
      "module": "compaction_failure",
      "userSynonyms": [
        "compaction failed",
        "parquet compaction broke",
        "athena table compaction error"
      ],
      "watches": "ec-manual-runs-service Parquet compaction crons (initiation + status)",
      "metric": "ec.manual_run_service.compaction_initiation_error_counter + ...compaction_status_error_counter",
      "threshold": "critical = 0",
      "priority": "P2",
      "note": "Metric-name hazard: OTEL LongCounters may surface with a _total suffix -> could read no-data/green."
    },
    {
      "module": "quota_manager_reconciled_event_consumer_error",
      "userSynonyms": [
        "quota reconciliation consumer failed",
        "reconciled event dead-lettered",
        "quota recon consumer error"
      ],
      "watches": "ec-surveillance-quota-manager reconciled-event consumer DLT",
      "metric": "ec.quota_manager.reconciled_event_consumer_dlt_counter",
      "threshold": "critical = 0",
      "priority": "P1"
    },
    {
      "module": "audit_event_consumer_failure",
      "userSynonyms": [
        "audit consumer failed",
        "audit dead-lettered",
        "ingestion failure record",
        "comm event DLT"
      ],
      "watches": "ec-centralised-audit communication-event consumer DLT",
      "metric": "ec.centralised_audit.communication_event_dlt_counter",
      "threshold": "critical = 0",
      "priority": "P1"
    },
    {
      "module": "legacy_config_consumer_failure",
      "userSynonyms": [
        "legacy config consumer error",
        "old config feed failed",
        "config curator legacy DLT"
      ],
      "watches": "ec-config-curator legacy-config consumer DLT",
      "metric": "ec.config_curator.legacy_config_consumer_dlt_counter",
      "threshold": "critical = 0",
      "priority": "P1",
      "resourceName": "config_curator_legacy_config_consumer_failure"
    },
    {
      "module": "cognition_reconciliation_communication_event_dlt",
      "userSynonyms": [
        "cognition recon dead-lettered",
        "AI reconciliation failed",
        "cognition comm event DLT"
      ],
      "watches": "ec-centralised-audit Cognition-reconciliation comm-event consumer DLT",
      "metric": "ec.centralised_audit.communication_event_dlt_counter_for_cognition_reconciliation",
      "threshold": "critical = 0",
      "priority": "P1"
    },
    {
      "module": "cdc_cognition_reconciliation_error",
      "userSynonyms": [
        "cognition CDC error",
        "AI recon cdc failed",
        "cognition reconciliation change-stream error"
      ],
      "watches": "ec-centralised-audit CDC-driven Cognition reconciliation error counter",
      "metric": "ec.centralised_audit.cdc_cognition_reconciliation_error_counter",
      "threshold": "critical = 0",
      "priority": "P1"
    },
    {
      "module": "kpi_event_consumer_error",
      "userSynonyms": [
        "KPI consumer failed",
        "stats consumer error",
        "kpi event dead-lettered"
      ],
      "watches": "KPI-event consumer in surveillance-filter, quota-manager, queue-qualifier (3 services)",
      "metric": "<service.prefix>.kpi_event_consumer_error_counter",
      "services": [
        "ec.surveillance_filter",
        "ec.quota_manager",
        "ec.pipeline_qualifier"
      ],
      "threshold": "critical = 0",
      "priority": "P2",
      "coverage": "15 instances"
    },
    {
      "module": "window_token_not_reconciled_in_time",
      "userSynonyms": [
        "window not reconciled",
        "recon didn't finish",
        "daily reconciliation missing",
        "window token stuck",
        "batch didn't reconcile"
      ],
      "watches": "ec-centralised-audit source-reconciliation completion in a daily timezone window",
      "metric": "<service.prefix>.source_recon_completed_success_counter",
      "query": "sum(last_<window>m):sum:...{kube_namespace:<env>,tenant:<tenant>} < 1",
      "threshold": "critical = 1 (alert when count < 1)",
      "priority": "P1",
      "note": "Timezone-grouped; evaluates once daily at window end. tz keys: UTC/CST/SGT/IST."
    },
    {
      "module": "pipeline_not_completion_in_time",
      "userSynonyms": [
        "pipeline didn't finish",
        "run not completed",
        "supervision didn't complete",
        "pipelines still pending",
        "queue didn't finish in time"
      ],
      "watches": "ec-reporting pending-pipeline gauge per window_token",
      "metric": "ec.reporting.pending_pipelines_count",
      "query": "min(last_<window>m):min:ec.reporting.pending_pipelines_count{kube_namespace:<env>,tenant:<tenant>} by {tenant,window_token} > 0",
      "threshold": "critical = 0",
      "priority": "P1",
      "note": "REWRITTEN (CONDUCT-12145): was abs(completed-active) diff, now single pending gauge. Cross-midnight schedule."
    },
    {
      "module": "monitored_corpus_above_trendline",
      "userSynonyms": [
        "ingest spike",
        "volume too high",
        "too many messages",
        "corpus spike",
        "traffic surge"
      ],
      "watches": "ec-centralised-audit ingested-corpus volume anomaly (spike)",
      "metric": "anomalies(ec.centralised_audit.conduct.ingested.count, direction='above', seasonality='weekly')",
      "threshold": "critical = 1",
      "priority": "P2"
    },
    {
      "module": "monitored_corpus_below_trendline",
      "userSynonyms": [
        "ingest drop",
        "volume too low",
        "not enough messages",
        "ingest stalled",
        "traffic dropped",
        "nothing coming in"
      ],
      "watches": "ec-centralised-audit ingest drop below weekly-seasonal trend",
      "metric": "anomalies(ec.centralised_audit.conduct.ingested.count, direction='below', seasonality='weekly')",
      "threshold": "critical = 1",
      "priority": "P2",
      "note": "Omits on_missing_data/notification_preset -> a true zero-ingest may be SUPPRESSED (gap G7)."
    },
    {
      "module": "lookback_initiation_failed",
      "blockName": "lookback_trigger_failure",
      "userSynonyms": [
        "lookback failed to start",
        "historical run didn't trigger",
        "backfill trigger failed"
      ],
      "watches": "ec-lookback trigger",
      "metric": "ec.lookback_service.lookback_trigger_total{outcome:failure}",
      "threshold": "critical = 0",
      "priority": "P3",
      "note": "Only tenants in var.lookback_tenants get this."
    },
    {
      "module": "lookback_no_completion_today",
      "blockName": "lookback_completion_count",
      "userSynonyms": [
        "lookback didn't finish",
        "not enough lookbacks completed",
        "backfill under-completed",
        "historical run count low"
      ],
      "watches": "ec-manual-runs-service lookback completion volume per tenant",
      "metric": "ec.manual_run_service.lookback_completed_total",
      "query": "sum(last_1d):...as_count() < <expected_count>",
      "threshold": "critical = expected_count (non-prod msanity=4, prod msuat=3, prod msprod=0)",
      "priority": "P3",
      "note": "prod msprod expected_count=0 => threshold < 0 can NEVER fire (inert monitor). Completion metric is ec.manual_run_service.* but trigger metric is ec.lookback_service.* (two different services)."
    },
    {
      "module": "remediation_snapshot_event_error_counter",
      "userSynonyms": [
        "remediation failed",
        "on-demand re-ingest dead-lettered",
        "remediation snapshot error",
        "reindex snapshot failed"
      ],
      "watches": "ec-manual-runs-service remediation-snapshot CDC consumer DLT (ec.on-demand.remediation-dlt)",
      "metric": "ec.manual_run_service.remediation_snapshot_event_error_counter",
      "threshold": "critical = 0",
      "priority": "P1",
      "note": "ONLY monitor with a {{#is_recovery}} auto-resolve block. Orphan doc dir modules/remediation_snapshot_event_error/ has no .tf."
    },
    {
      "module": "ec_indexer_consumer_failure",
      "userSynonyms": [
        "indexer failed",
        "indexing dead-lettered",
        "ES load failed",
        "indexer consumer error"
      ],
      "watches": "ec-indexer 3 indexing consumers' DLT/error counters",
      "metric": [
        "ec.indexer.indexing_error_counter",
        "ec.indexer.surveilled_communication_error_counter",
        "ec.indexer.parent_reindexing_error_counter"
      ],
      "threshold": "critical = 0",
      "priority": "P1",
      "coverage": "15 instances (tenant x 3 consumers)"
    }
  ],
