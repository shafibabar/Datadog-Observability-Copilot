      "resolvedQuery": "ec.quota_manager.conduct.pipeline.sampling.status{*} by {pipeline_id,pipeline_name,sampling_status,sampling_bucket}",  
      "answerShape": "gauge/state per pipeline",  
      "confidence": "verified",  
      "note": "conduct.pipeline.sampling.status is a status gauge tagged with sampling_status + sampling_bucket." },  
  
    { "id": "IDX-001",  
      "question": "Are alerted communications failing to index?",  
      "parsed": {"intent":"ERROR_RATE","service":"ec-indexer","object":"alerted_communication","timeRange":"4h"},  
      "resolvedQuery": "sum:ec.indexer.alerted_communication_error_counter{*} by {tenant,error_code}.as_count()",  
      "answerShape": "error count",  
      "confidence": "verified" },  
  
    { "id": "REV-001",  
      "question": "How often is the create-reviewer-group API called and how slow is it?",  
      "parsed": {"intent":"API_HEALTH","service":"ec-review-service","object":"create_reviewer_group","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.review_service.create_reviewer_group_hit_rate{*}.as_count() ; latency histogram for create_reviewer_group ; ec.review_service.create_reviewer_group_error_counter",  
      "answerShape": "hit rate + latency + error",  
      "confidence": "medium",  
      "note": "per-endpoint pattern {metric}_hit_rate + {metric}_error_counter + TenantLatencyHistogram; 17 @ApiMetricName endpoints." },  
  
    { "id": "FLT-001",  
      "question": "How slow is 'fetch policies by pipeline' in the filter service?",  
      "parsed": {"intent":"LATENCY","service":"ec-surveillance-filter","object":"fetch_policies_by_pipeline","percentile":"p95"},  
      "resolvedQuery": "p95:ec.surveillance_filter.fetch_policies_by_pipeline_api_latency{*} by {tenant}",  
      "answerShape": "latency ms",  
      "confidence": "medium" },  
  
    { "id": "MRUN-001",  
      "question": "Did any lookback get rejected for exceeding the Athena result-set limit?",  
      "parsed": {"intent":"COUNT_OUTCOME","service":"ec-manual-runs-service","object":"lookback_athena_result_guardrail_exceeded","timeRange":"1w"},  
      "resolvedQuery": "sum:lookback_athena_result_guardrail_exceeded_total{*} by {tenant}.as_count()",  
      "answerShape": "count of rejected lookbacks",  
      "confidence": "medium",  
      "note": "metric literal verified via workpack; group prefix not source-read." }  
  ],  
  
  "notAnswerableFromMetrics": {  
    "description": "Questions users will ask that CANNOT be answered from metrics alone — route these to logs/traces/config/dashboards instead. Useful negative-training data.",  
    "cases": [  
      {"question": "are we backed up / behind on any Kafka topic?", "why": "kafka.consumer_lag has dashboard widgets but is derived from broker lag, not an emitted service metric; treat as dashboard-only"},  
      {"question": "why did message with GCID X fail?", "why": "requires log/trace lookup by id; metrics are aggregate counts only"},  
      {"question": "which specific policy matched this comm?", "why": "per-message disposition lives in data stores/logs, not metrics"},  
      {"question": "is audio search enabled for tenant Y?", "why": "config/feature-flag lookup (Mongo doc), not a metric"},  
      {"question": "how many echoes vs originals were detected?", "why": "echo-engine ORIGINAL/ECHO/OUT_OF_ORDER counters not confirmed as separate emitted series"},  
      {"question": "what's the exact gateway ingestion throughput series?", "why": "ec-gateway GROUP_NAME + consumer metric literals not source-verified (only remediation_event_forward_error_counter confirmed)"}  
    ]  
  }  
}