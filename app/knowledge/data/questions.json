      "answerShape": "error count by exception",  
      "confidence": "verified" },  
  
    { "id": "ERR-003",  
      "question": "Is the quota manager's KPI consumer or publisher erroring?",  
      "parsed": {"intent":"ERROR_RATE","service":"ec-surveillance-quota-manager","object":["kpi_event_consumer","kpi_event_publisher"],"timeRange":"4h"},  
      "resolvedQuery": "sum:ec.quota_manager.kpi_event_consumer_error_counter{*}.as_count() ; sum:ec.quota_manager.kpi_event_publisher_error_counter{*}.as_count()",  
