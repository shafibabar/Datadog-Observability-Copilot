{  
  "$schema": "ec-surveillance-metric-answerable-questions/v1",  
  "metadata": {  
    "name": "EC Surveillance — Questions Answerable From Datadog Metrics Only",  
    "description": "An extensive corpus of natural-language questions a non-technical user can ask that are answerable purely by reading Datadog/OTel metric time-series (no dashboards, logs, or traces required). Each entry has the user question, the parsed intent/slots, the exact resolved metric query, what the answer looks like, and a confidence level. Full series name = GROUP_NAME + '.' + metricName.",  
    "answerabilityRule": "Included ONLY if a single metric series (or simple ratio/sum of series) yields the answer. Questions requiring log inspection, trace spans, or config lookups are excluded (see notAnswerableFromMetrics at the end).",  
    "groupNames": {  
      "ec-indexer": "ec.indexer",  
      "ec-surveillance-quota-manager": "ec.quota_manager",  
      "ec-reporting": "ec.reporting",  
      "ec-centralised-audit": "ec.centralised_audit",  
      "ec-alerting-service": "ec.alerting_service",  
      "ec-review-service": "ec.review_service",  
      "ec-surveillance-filter": "ec.surveillance_filter",  
      "ec-surveillance-policy-evaluator": "ec.surveillance_policy_evaluator",  
      "ec-gateway": "(not verified)",  
      "ec-queue-qualifier": "(not verified)",  
      "ec-manual-runs-service": "(not verified)",  
      "ec-echo-engine": "(not verified)"  
    },  
    "commonTags": ["tenant", "topic", "pipeline_id", "pipeline_name", "window_token", "reconciliation_token", "source", "sourceId", "exception", "error_code"],  
    "intentLegend": {  
      "COUNT_STAGE": "how many comms reached / passed a lifecycle stage (business volume)",  
      "COUNT_OUTCOME": "how many got a specific disposition (sampled, filtered, ignored, alerted)",  
      "FUNNEL_RATIO": "conversion/drop ratio between two stages",  
      "LATENCY": "how slow (histogram, p50/p95/p99)",  
      "THROUGHPUT": "processing rate over time (counter.as_rate/as_count)",  
      "ERROR_RATE": "failure counter / error rate",  
      "DEADLETTER": "dlt counter (given-up messages)",  
      "API_HEALTH": "REST endpoint counter+latency+error",  
      "RECON": "reconciliation completion counts",  
      "SAMPLING_STATE": "current sampling gauge / sampling status"  
    }  
  },  
  
  "questions": [  
  
    { "id": "STG-001",  
      "question": "How many communications were ingested today for Morgan Stanley?",  
      "parsed": {"intent":"COUNT_STAGE","service":"ec-centralised-audit","stage":"ingested","tenant":"msprod","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.ingested.count{tenant:msprod}.as_count()",  
      "answerShape": "single integer (count of ingested comms)",  
      "confidence": "verified" },  
  
    { "id": "STG-002",  
      "question": "How many were qualified into a pipeline vs not qualified?",  
      "parsed": {"intent":"FUNNEL_RATIO","service":"ec-centralised-audit","stages":["qualified","not_qualified"],"tenant":"*","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.qualified.count{*}.as_count() / (sum:ec.centralised_audit.conduct.qualified.count{*}.as_count() + sum:ec.centralised_audit.conduct.not_qualified.count{*}.as_count())",  
      "answerShape": "ratio + two counts",  
      "confidence": "verified" },  
  
    { "id": "STG-003",  
      "question": "How many messages were surveilled (kept for review)?",  
      "parsed": {"intent":"COUNT_STAGE","service":"ec-centralised-audit","stage":"surveilled","tenant":"*","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.surveilled.count{*} by {tenant}.as_count()",  
      "answerShape": "count per tenant",  
      "confidence": "verified" },  
  
    { "id": "STG-004",  
      "question": "How many got filtered out / ignored?",  
      "parsed": {"intent":"COUNT_OUTCOME","service":"ec-centralised-audit","outcome":"filtered","tenant":"*","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.filtered.count{*} by {tenant}.as_count()",  
      "answerShape": "count per tenant",  
      "confidence": "verified" },  
  
    { "id": "STG-005",  
      "question": "How many were randomly sampled by the quota manager?",  
      "parsed": {"intent":"COUNT_OUTCOME","service":"ec-centralised-audit","outcome":"quota_sampled","tenant":"*","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.quota.surveilled.sampled.count{*} by {tenant}.as_count()",  
      "answerShape": "count per tenant",  
      "confidence": "verified" },  
  
    { "id": "STG-006",  
      "question": "How many were considered for sampling but NOT sampled (dropped)?",  
      "parsed": {"intent":"COUNT_OUTCOME","service":"ec-centralised-audit","outcome":"quota_not_sampled","tenant":"*","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.quota.surveilled.not_sampled.count{*} by {tenant}.as_count()",  
      "answerShape": "count per tenant",  
      "confidence": "verified" },  
  
    { "id": "STG-007",  
      "question": "How many random (not-qualified) comms were sampled vs not sampled?",  
      "parsed": {"intent":"FUNNEL_RATIO","service":"ec-centralised-audit","stages":["random_sampled","random_not_sampled"],"tenant":"*","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.quota.random.sampled.count{*}.as_count() vs sum:ec.centralised_audit.conduct.quota.random.not_sampled.count{*}.as_count()",  
      "answerShape": "two counts",  
      "confidence": "verified" },  
  
    { "id": "STG-008",  
      "question": "How many messages did Cognition (the AI) successfully evaluate?",  
      "parsed": {"intent":"COUNT_STAGE","service":"ec-centralised-audit","stage":"cognition_succeeded","tenant":"*","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.cognition.succeeded.count{*} by {tenant}.as_count()",  
      "answerShape": "count per tenant",  
      "confidence": "verified" },  
  
    { "id": "STG-009",  
      "question": "How many Cognition evaluations timed out?",  
      "parsed": {"intent":"COUNT_OUTCOME","service":"ec-centralised-audit","outcome":"cognition_timeout","tenant":"*","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.cognition.timeout.count{*} by {tenant}.as_count()",  
      "answerShape": "count per tenant",  
      "confidence": "verified" },  
  
    { "id": "STG-010",  
      "question": "Break down the whole funnel by stage for last 24h",  
      "parsed": {"intent":"COUNT_STAGE","service":"ec-centralised-audit","stage":"ALL","tenant":"*","timeRange":"1d"},  
      "resolvedQuery": "sum by stage of: conduct.ingested.count, conduct.qualified.count, conduct.surveilled.count, conduct.cognition.succeeded.count, conduct.quota.surveilled.sampled.count (all under ec.centralised_audit)",  
      "answerShape": "ordered funnel of counts",  
      "confidence": "verified",  
      "note": "This is the single most powerful metric-only funnel view; every stage counter lives in ec-centralised-audit." },  
  
    { "id": "PIPE-001",  
      "question": "For pipeline (queue) X, how many comms were surveilled?",  
      "parsed": {"intent":"COUNT_STAGE","service":"ec-centralised-audit","stage":"surveilled","groupBy":"pipeline_id","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.conduct.queue.v3.surveilled.count{*} by {pipeline_id,pipeline_name}.as_count()",  
      "answerShape": "count per pipeline",  
      "confidence": "verified",  
      "note": "conduct.queue.v3.* are per-pipeline variants of the stage counters, tagged pipeline_id/pipeline_name." },  
  
    { "id": "PIPE-002",  
      "question": "Which queue is dropping the most messages at the filter stage?",  
      "parsed": {"intent":"COUNT_OUTCOME","service":"ec-centralised-audit","outcome":"filtered","groupBy":"pipeline_name","timeRange":"1d","sort":"desc"},  
      "resolvedQuery": "top(sum:ec.centralised_audit.conduct.queue.v3.filtered.count{*} by {pipeline_name}.as_count(), 10, 'sum', 'desc')",  
      "answerShape": "ranked list of pipelines",  
      "confidence": "verified" },  
  
    { "id": "LAT-001",  
      "question": "How slow is the alert-fetch (supervised item) API at p99?",  
      "parsed": {"intent":"LATENCY","service":"ec-alerting-service","object":"supervised_item_get","percentile":"p99","tenant":"*"},  
      "resolvedQuery": "p99:ec.alerting_service.supervised_item_get_api_latency{*} by {tenant}",  
      "answerShape": "latency ms",  
      "confidence": "verified" },  
  
    { "id": "LAT-002",  
      "question": "How long is enrichment / S3 fetch taking in alerting?",  
      "parsed": {"intent":"LATENCY","service":"ec-alerting-service","object":["enrichment","s3_fetch"],"percentile":"p95"},  
      "resolvedQuery": "p95:ec.alerting_service.enrichment_latency{*} ; p95:ec.alerting_service.s3_fetch_latency{*}",  
      "answerShape": "two latency series",  
      "confidence": "verified" },  
  
    { "id": "LAT-003",  
      "question": "How fast is the indexer ingesting messages into Elasticsearch?",  
      "parsed": {"intent":"LATENCY","service":"ec-indexer","object":"ingested_communication","percentile":"p95"},  
      "resolvedQuery": "p95:ec.indexer.ingested_communication_event_latency{*} by {tenant}",  
      "answerShape": "latency ms per tenant",  
      "confidence": "verified" },  
  
    { "id": "LAT-004",  
      "question": "What's the pipeline execution report API response time?",  
      "parsed": {"intent":"LATENCY","service":"ec-reporting","object":"pipeline_execution_report","percentile":"p99"},  
      "resolvedQuery": "p99:ec.reporting.pipeline_execution_report_api_latency{*} by {tenant}",  
      "answerShape": "latency ms",  
      "confidence": "verified" },  
  
    { "id": "LAT-005",  
      "question": "How long do quota-manager Mongo audit-metadata saves take?",  
      "parsed": {"intent":"LATENCY","service":"ec-surveillance-quota-manager","object":"mongo_save_audit_metadata_outbox","percentile":"p95"},  
      "resolvedQuery": "p95:ec.quota_manager.mongo_save_audit_metadata_outbox_latency{*} by {tenant}",  
      "answerShape": "latency ms",  
      "confidence": "medium",  
      "note": "@RecordLatency site verified via workpack; group prefix ec.quota_manager verified from source." },  
  
    { "id": "THR-001",  
      "question": "What's the ingest throughput on the indexer right now?",  
      "parsed": {"intent":"THROUGHPUT","service":"ec-indexer","object":"ingested_communication","timeRange":"1h"},  
      "resolvedQuery": "sum:ec.indexer.ingested_communication_consumption_rate{*} by {tenant}.as_rate()",  
      "answerShape": "messages/sec trend",  
      "confidence": "verified" },  
  
    { "id": "THR-002",  
      "question": "How many surveilled comms did the indexer process this hour?",  
      "parsed": {"intent":"THROUGHPUT","service":"ec-indexer","object":"surveilled_communication","timeRange":"1h"},  
      "resolvedQuery": "sum:ec.indexer.surveilled_communication_consumption_rate{*}.as_count()",  
      "answerShape": "count",  
      "confidence": "verified" },  
  
    { "id": "THR-003",  
      "question": "How many KPI events did the quota manager consume?",  
      "parsed": {"intent":"THROUGHPUT","service":"ec-surveillance-quota-manager","object":"kpi_event","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.quota_manager.kpi_event_consumption_rate{*} by {tenant}.as_count()",  
      "answerShape": "count",  
      "confidence": "verified" },  
  
    { "id": "THR-004",  
      "question": "How many alerts were published by the alerting service?",  
      "parsed": {"intent":"THROUGHPUT","service":"ec-alerting-service","object":"alert_published","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.alerting_service.alert_published_counter{*} by {tenant}.as_count()",  
      "answerShape": "count of published alerts",  
      "confidence": "verified" },  
  
    { "id": "ERR-001",  
      "question": "Are there indexing errors?",  
      "parsed": {"intent":"ERROR_RATE","service":"ec-indexer","object":"indexing","timeRange":"4h"},  
      "resolvedQuery": "sum:ec.indexer.indexing_error_counter{*} by {tenant,error_code}.as_count()",  
      "answerShape": "error count grouped by error_code",  
      "confidence": "verified" },  
  
    { "id": "ERR-002",  
      "question": "How many surveilled-comm processing errors in alerting?",  
      "parsed": {"intent":"ERROR_RATE","service":"ec-alerting-service","object":"surveilled_communication","timeRange":"4h"},  
