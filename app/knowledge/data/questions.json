      "resolvedQuery": "counter ec.alerting_service.alert_config_create_api_counter ; error ec.alerting_service.alert_config_create_api_error_counter ; p99 ec.alerting_service.alert_config_create_api_latency",  
      "answerShape": "triad (count/error/latency)",  
      "confidence": "verified" },  
  
    { "id": "API-002",  
      "question": "How many supervised-item update calls, and how many failed?",  
