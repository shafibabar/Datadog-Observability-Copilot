      "answerShape": "failed count per stage",  
      "confidence": "verified" },  
  
    { "id": "DLT-001",  
      "question": "How many surveilled-communication events got dead-lettered in alerting?",  
      "parsed": {"intent":"DEADLETTER","service":"ec-alerting-service","object":"surveilled_communication","timeRange":"1d"},  
