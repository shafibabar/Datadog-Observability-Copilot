      "answerShape": "count + error count",  
      "confidence": "verified" },  
  
    { "id": "RECON-001",  
      "question": "How many windows / sources were successfully reconciled?",  
      "parsed": {"intent":"RECON","service":"ec-centralised-audit","object":"source_recon_completed","timeRange":"1d"},  
      "resolvedQuery": "sum:ec.centralised_audit.source_recon_completed_success_counter{*} by {tenant}.as_count()",  
      "answerShape": "count of reconciled sources",  
      "confidence": "verified" },  
  
    { "id": "RECON-002",  
